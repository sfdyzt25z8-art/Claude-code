# FocusFlow — environment variables
#
# The AI Coach works out of the box with a local, rule-based fallback —
# no API key required. To connect a real AI provider, set the variables
# below and restart the dev server (Vite only reads VITE_-prefixed vars).
#
# Never commit your real .env file — it is already git-ignored.

# Example: an Anthropic Claude API key, used by src/lib/aiCoach.ts if present.
# Get one at https://console.anthropic.com/
VITE_AI_API_KEY=

# Optional: override the AI model used by the AI Coach integration.
VITE_AI_MODEL=claude-sonnet-5
