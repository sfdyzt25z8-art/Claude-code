# --- Database ---
# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/organizer?schema=public"

# --- Server ---
PORT=4000
# Comma-separated list of allowed CORS origins (web app, mobile dev server, etc.)
CORS_ORIGIN="http://localhost:3000,http://localhost:19006"
NODE_ENV=development

# --- Firebase Admin (server-side token verification) ---
# Create a service account in the Firebase console -> Project Settings -> Service Accounts
# -> "Generate new private key". Copy the three fields below from the downloaded JSON.
# If these are left empty, firebase-admin will NOT be initialized and a warning is logged
# at boot; real Bearer-token requests will then fail auth until they are configured.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the literal \n sequences in the private key when pasting it into this single-line value.
FIREBASE_PRIVATE_KEY=""

# --- Dev-only auth bypass ---
# NEVER enable this in production. When "true", any request that sends the
# `x-dev-user-email` header is treated as an authenticated user with that email,
# instead of requiring a real Firebase ID token. Intended purely for local development
# and automated tests when no Firebase project is configured.
ALLOW_DEV_AUTH_BYPASS=false

# --- OpenAI (AI chat / quiz generation) ---
# If left empty, AI features gracefully fall back to static/local generators.
OPENAI_API_KEY=

# --- File storage ---
# "local" (default, writes to apps/backend/uploads and serves them at /uploads) or "s3"
STORAGE_PROVIDER=local
AWS_REGION=us-east-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
