# Backend API base URL.
# - iOS simulator / web: http://localhost:4000 works fine.
# - Physical device or Android emulator: replace with your dev machine's
#   LAN IP, e.g. http://192.168.1.23:4000 (the device cannot resolve
#   "localhost" back to your computer). Find your IP with `ipconfig getifaddr en0`
#   (macOS) or `ip addr` (Linux).
EXPO_PUBLIC_API_URL=http://localhost:4000

# Firebase web app config (same project as apps/backend + apps/web).
# From Firebase console -> Project settings -> General -> Your apps -> Web app.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# Google sign-in OAuth client IDs (Firebase console -> Authentication ->
# Sign-in method -> Google -> Web SDK configuration, plus platform-specific
# client IDs created in Google Cloud Console for expo-auth-session).
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
