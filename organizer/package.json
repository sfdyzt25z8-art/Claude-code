{
  "name": "organizer",
  "private": true,
  "version": "0.1.0",
  "description": "Organizer - AI-powered life operating system (web, mobile, backend monorepo)",
  "workspaces": [
    "apps/backend",
    "apps/web",
    "apps/mobile",
    "packages/shared"
  ],
  "scripts": {
    "prepare": "npm run build:shared",
    "dev:backend": "npm run dev --workspace=apps/backend",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:mobile": "npm run start --workspace=apps/mobile",
    "build:shared": "npm run build --workspace=packages/shared",
    "build:backend": "npm run build --workspace=apps/backend",
    "build:web": "npm run build --workspace=apps/web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
